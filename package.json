{
  "name": "@nodestackapp/server",
  "version": "1.3.0",
  "description": "The TypeScript-Native Backend Stack. Single-process backend with embedded SQLite, instant CRUD, Auth, Realtime, Files & Admin UI.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    }
  },
  "bin": {
    "nodestack": "bin/nodestack.js",
    "server": "bin/nodestack.js",
    "nodebase": "bin/nodebase.js"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "bin"
  ],
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client && npm run build:plugins && npm run docs:build",
    "build:server": "tsc && node -e \"const fs = require('fs'); fs.mkdirSync('dist/admin/ui', { recursive: true }); fs.cpSync('src/admin/ui', 'dist/admin/ui', { recursive: true }); const { AdminUIBundler } = require('./dist/admin/AdminUIBundler'); fs.writeFileSync('dist/admin/ui/index.html', AdminUIBundler.bundle('dist/admin/ui'));\"",
    "build:client": "npm --workspace=packages/client run build",
    "build:plugins": "node scripts/build-plugins.js",
    "publish:plugins": "node scripts/publish-plugins.js",
    "dev": "tsx src/cli/cli.ts start",
    "start": "node bin/nodestack.js start",
    "demo:backend": "node bin/nodestack.js start --template ecommerce",
    "demo:frontend": "npm --prefix examples/ecommerce-react run dev",
    "demo:build": "npm --prefix examples/ecommerce-react run build",
    "test": "vitest run",
    "docs": "npm --prefix docs run start",
    "docs:build": "npm --prefix docs run build",
    "docs:serve": "npm --prefix docs run serve"
  },
  "keywords": [
    "nodestack",
    "backend-stack",
    "baas",
    "sqlite",
    "typescript",
    "realtime",
    "embedded",
    "fastify",
    "crud"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "bcryptjs": "^3.0.2",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "find-my-way": "^9.10.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "jsdom": "^30.1.2",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^3.0.8"
  }
}
