# NodeStack Backend Base URL
VITE_NODESTACK_URL=http://localhost:8090

# Optional: Specify application name/slug if using multi-app isolation.
# If your ecommerce template is applied inside a specific app (e.g. "ecommerce" or "shop"),
# set its slug here (e.g., VITE_NODESTACK_APP=ecommerce).
# Leave blank to use the default app.
VITE_NODESTACK_APP=ecommerce
