    "type": "git",
    "url": "git+https://github.com/satya-jugran/nodebase.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/satya-jugran/nodebase/issues"
  },
  "homepage": "https://github.com/satya-jugran/nodebase#readme",
  "keywords": [
    "nodestack",
    "nodestack-client",
    "sdk",
    "api-client",
    "realtime",
