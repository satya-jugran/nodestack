{
  "name": "@nodestackapp/plugin-stripe",
  "version": "1.2.0",
  "description": "Official Stripe payments, checkout sessions & webhooks plugin for NodeStack",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "nodestack": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "nodestack": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satya-jugran/nodestack.git",
    "directory": "packages/plugins/stripe"
  },
  "keywords": [
    "nodestack",
    "plugin",
    "stripe",
    "payments",
    "checkout",
    "billing",
    "webhooks"
  ],
  "author": "",
  "license": "MIT"
}
